# Copy this file to .spot/robot.env and fill in local values.
# Keep .spot/robot.env local to your machine. It is ignored by git.
#
# The SDK reads BOSDYN_CLIENT_USERNAME and BOSDYN_CLIENT_PASSWORD from the environment.
# The Kinesis helper scripts read SPOT_HOSTNAME and then export the SDK variables.
SPOT_HOSTNAME=192.168.80.3
BOSDYN_CLIENT_USERNAME=robot-user
BOSDYN_CLIENT_PASSWORD=change-me
